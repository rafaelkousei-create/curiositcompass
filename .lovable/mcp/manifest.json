{
  "version": 1,
  "sdk_version": "3.2.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://gzloaxlzsexstnqmuohe.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "curiosity-compass",
      "version": "0.1.0",
      "title": "Curiosity Compass"
    },
    "tools": [
      {
        "name": "discover_landmark",
        "title": "Discover a nearby landmark",
        "description": "Generate a factual landmark story near coordinates supplied by the caller; does not read the browser's GPS or history.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "description": "Latitude of the location to explore."
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "description": "Longitude of the location to explore."
            },
            "heard": {
              "default": [],
              "description": "Names of landmarks to exclude.",
              "maxItems": 40,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              }
            }
          },
          "required": [
            "lat",
            "lng"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "identify_place",
        "title": "Identify a described place",
        "description": "Match a description to a real place near caller-supplied coordinates and generate its story; uses app AI credits.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "description": "Latitude of the location to explore."
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "description": "Longitude of the location to explore."
            },
            "description": {
              "type": "string",
              "minLength": 2,
              "maxLength": 400,
              "description": "Visible details of the place to identify."
            }
          },
          "required": [
            "lat",
            "lng",
            "description"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
